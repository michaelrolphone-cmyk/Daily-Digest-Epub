{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Daily Digest editorial source v1",
  "type": "object",
  "required": ["schema_version", "date", "title", "subtitle", "language", "timezone", "published_at", "reporting_cutoff", "editor_note", "articles"],
  "properties": {
    "schema_version": {"const": 1},
    "date": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "title": {"type": "string", "minLength": 1},
    "subtitle": {"type": "string", "minLength": 1},
    "edition_label": {"type": "string", "minLength": 1, "maxLength": 80, "description": "Cover label; omitted retains the original EVENING EDITION."},
    "cover_topics": {"type": "string", "minLength": 1, "maxLength": 120, "description": "Optional topic strapline; omission retains historical cover bytes."},
    "language": {"type": "string", "minLength": 2},
    "timezone": {"type": "string", "minLength": 1},
    "published_at": {"type": "string", "format": "date-time"},
    "reporting_cutoff": {"type": "string", "format": "date-time"},
    "editor_note": {"type": "string", "minLength": 1},
    "front_page": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "articles": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "section", "title", "dek", "timing", "paragraphs", "sources"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "section": {"type": "string"}, "title": {"type": "string"}, "dek": {"type": "string"}, "timing": {"type": "string"},
          "paragraphs": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["text"], "properties": {"text": {"type": "string", "minLength": 1}, "heading": {"type": "string"}, "kind": {"enum": ["reporting", "analysis", "context"]}, "refs": {"type": "array", "items": {"type": "integer", "minimum": 1}}}}},
          "sources": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["title", "publisher", "url"], "properties": {"title": {"type": "string"}, "publisher": {"type": "string"}, "url": {"type": "string", "format": "uri", "pattern": "^https://"}, "published": {"type": ["string", "null"], "format": "date"}}}}
        }
      }
    }
  }
}
